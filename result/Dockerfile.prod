FROM node:24-trixie-slim

ENV NODE_ENV=production
ENV PORT=8080

RUN apt-get update && \
    apt-get install -y --no-install-recommends tini && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /usr/local/app

COPY package*.json ./

RUN npm ci --omit=dev && \
    npm cache clean --force

# npm is only needed while installing dependencies.
# Remove bundled npm tooling from the production runtime.
RUN rm -rf /usr/local/lib/node_modules/npm \
    /usr/local/bin/npm \
    /usr/local/bin/npx

COPY --chown=node:node . .

USER node

EXPOSE 8080

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "server.js"]
